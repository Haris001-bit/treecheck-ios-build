# Capacitor Android — generated / machine-local (do not commit)
# Based on: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle
.gradle/
build/

# Local SDK path (machine-specific)
local.properties

# Proguard
proguard/

# Logs
*.log

# Android Studio / IntelliJ
.navigation/
captures/
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml
vcs.xml

# Keystore / signing (never commit release keys)
*.jks
*.keystore
!debug.keystore
keystore.properties
*.pem

# Native build caches
.externalNativeBuild
.cxx/

# Profiling
*.hprof

# Cordova plugins bridge (regenerated by Capacitor)
capacitor-cordova-android-plugins

# Copied web assets from `npx cap sync` / `cap copy`
app/src/main/assets/public

# Generated Capacitor config copies (source of truth: root capacitor.config.ts)
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Optional: uncomment if Firebase config should stay private (CI injects it)
# app/google-services.json
