# Environment variable template — copy to `.env` and fill in values.
# Never commit real secrets.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Dev overlays
VITE_DEVELOPMENT=false
VITE_DEBUG_CONSOLE=false

# iOS Apple IAP via RevenueCat (native iOS only)
VITE_IOS_USE_IAP=true
# Public iOS SDK key only (starts with appl_). Do NOT use test_ (Test Store) or sk_/rcb_ secret keys.
VITE_REVENUECAT_IOS_API_KEY=
# When IAP is on, keep external Safari unlock off
VITE_IOS_EXTERNAL_PURCHASE_LINKS_ALLOWED=false
VITE_IOS_EXTERNAL_PURCHASE_LINK_REGION=US
VITE_TREECHECK_WEB_BASE_URL=https://trccai.lovable.app
